<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{club}} Contract Length</title>
    <link rel="icon" href="/images/{{club}}.png">
    <link rel="stylesheet" href="/css/svenskafans.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap">
</head>

<body>
    <div class="box">
        <div class="box-top">
            <h2 class="box-top-title">{{club}}s Spelarkontrakt</h2>
        </div>
        <div class="box-item">
            {{#each result.data}}
            <img src="{{playerImageSrc image}}" height="26px" width="20px" alt="{{name}}">
            #{{number}} {{name}}, Value: {{marketValue}}<br>
            {{/each}}
        </div>
        <div class="box-bottom">
            Data: <a href="https://transfermarkt-football-data-api.p.rapidapi.com"
                target="_blank">transfermarkt-football-data-api.p.rapidapi.com</a>
            , Kod: <a href="https://github.com/thulin82/arsenal-data" target="_blank">GitHub</a>
        </div>
    </div>
</body>

</html>